{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TalentHub: Run",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal"
    },
    {
      "name": "TalentHub: Seed demo data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/seed.py",
      "console": "integratedTerminal"
    },
    {
      "name": "TalentHub: Tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"],
      "console": "integratedTerminal"
    }
  ]
}
